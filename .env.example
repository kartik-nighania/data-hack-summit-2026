# Copy this file to `.env` (same folder) and paste your own keys — no quotes needed.
# Where to get them:
#   OpenAI:   https://platform.openai.com/api-keys
#   Langfuse: https://cloud.langfuse.com -> your project -> Settings -> API Keys
OPENAI_API_KEY=sk-proj-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# EU region accounts: use https://cloud.langfuse.com instead
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
